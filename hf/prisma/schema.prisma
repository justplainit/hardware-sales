// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TECH
  SALES
  ACCOUNTS
}

enum PaymentTerms {
  PREPAY
  EOM
  DAYS_30 @map("30_DAYS")
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  DECLINED
  STALE
  PARTIALLY_FULFILLED
  FULFILLED
}

enum ClientDecision {
  PENDING
  APPROVED
  DECLINED
}

enum DeliveryMethod {
  TO_OFFICE
  DIRECT_TO_END_USER
  DIRECT_TO_SITE
}

enum QuoteItemStatus {
  QUOTED
  ORDER_PENDING
  ORDERED
  RECEIVED_OFFICE
  DELIVERED_DIRECT
  DISPATCHED
  INSTALLED
  CANCELLED
}

enum SupplierOrderStatus {
  PENDING
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

enum InvoiceStatus {
  NOT_CREATED
  CREATED
  SENT
  PAID
}

enum PaymentRequired {
  PREPAY_REQUIRED
  PRIVILEGED_ALLOWED
}

enum DispatchDestination {
  INSTALLATION
  DELIVERY
}

enum TaskStatus {
  OPEN
  DONE
}

model User {
  id             String       @id @default(cuid())
  name           String
  email          String       @unique
  emailVerified  DateTime?
  image          String?
  role           UserRole     @default(TECH)
  passwordHash   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  accounts       Account[]
  sessions       Session[]
  notifications  Notification[]
  assignedQuotes Quote[]      @relation("AssignedSales")
  createdQuotes  Quote[]      @relation("QuoteCreator")
  assignedItems  QuoteItem[]  @relation("AssignedTechnician")
  supplierOrders SupplierOrder[] @relation("SupplierOrderCreatedBy")
  goodsReceipts  GoodsReceipt[]
  dispatches     Dispatch[]
  tasks          Task[]
}

model Client {
  id              String        @id @default(cuid())
  name            String
  billingEmail    String
  deliveryAddress String
  isPrivileged    Boolean       @default(false)
  paymentTerms    PaymentTerms  @default(PREPAY)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  quotes          Quote[]
}

model Supplier {
  id              String        @id @default(cuid())
  name            String
  contactEmail    String
  defaultLeadDays Int           @default(0)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  quoteItems      QuoteItem[]
  supplierOrders  SupplierOrder[]
}

model Quote {
  id                 String         @id @default(cuid())
  quoteNumber        String         @unique
  clientId           String
  createdByUserId    String
  assignedSalesUserId String?
  status             QuoteStatus    @default(DRAFT)
  validUntil         DateTime?
  clientContactName  String?
  clientContactEmail String?
  clientDecision     ClientDecision @default(PENDING)
  subtotal           Decimal        @default(0) @db.Decimal(12, 2)
  vat               Decimal        @default(0) @db.Decimal(12, 2)
  total             Decimal        @default(0) @db.Decimal(12, 2)
  sentAt             DateTime?
  staleAt            DateTime?
  reminder24SentAt   DateTime?
  reminder72SentAt   DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  client             Client         @relation(fields: [clientId], references: [id])
  createdBy          User           @relation("QuoteCreator", fields: [createdByUserId], references: [id])
  assignedSales      User?          @relation("AssignedSales", fields: [assignedSalesUserId], references: [id])
  items              QuoteItem[]
  supplierOrders     SupplierOrder[]
  invoice            Invoice?
  dispatches         Dispatch[]
  accessTokens       QuoteAccessToken[]
}

model QuoteItem {
  id                       String         @id @default(cuid())
  quoteId                  String
  description              String
  qty                      Int
  costPrice                Decimal        @default(0) @db.Decimal(12, 2)
  sellPrice                Decimal        @default(0) @db.Decimal(12, 2)
  marginPct                Float          @default(0)
  supplierId               String?
  etaDate                  DateTime?
  deliveryMethod           DeliveryMethod @default(TO_OFFICE)
  deliveryContactName      String?
  deliveryContactPhone     String?
  deliveryAddressOverride  String?
  assignedTechnicianUserId String?
  itemStatus               QuoteItemStatus @default(QUOTED)
  serialNumber             String?
  warrantyExpiryDate       DateTime?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  quote             Quote           @relation(fields: [quoteId], references: [id])
  supplier          Supplier?       @relation(fields: [supplierId], references: [id])
  assignedTechnician User?          @relation("AssignedTechnician", fields: [assignedTechnicianUserId], references: [id])
  supplierOrderItems SupplierOrderItem[]
  goodsReceiptItems  GoodsReceiptItem[]
  dispatchItems      DispatchItem[]
  tasks              Task[]
}

model SupplierOrder {
  id                   String              @id @default(cuid())
  supplierOrderNumber  String              @unique
  supplierId           String
  quoteId              String
  status               SupplierOrderStatus @default(PENDING)
  orderedAt            DateTime?
  expectedEtaDate      DateTime?
  deliveryMethod       DeliveryMethod      @default(TO_OFFICE)
  deliveryAddress      String?
  deliveryContactName  String?
  deliveryContactPhone String?
  supplierReference    String?
  createdByUserId      String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  supplier      Supplier           @relation(fields: [supplierId], references: [id])
  quote         Quote              @relation(fields: [quoteId], references: [id])
  createdBy     User?              @relation("SupplierOrderCreatedBy", fields: [createdByUserId], references: [id])
  items         SupplierOrderItem[]
  goodsReceipts GoodsReceipt[]
}

model SupplierOrderItem {
  id              String   @id @default(cuid())
  supplierOrderId String
  quoteItemId     String
  qty             Int

  supplierOrder SupplierOrder @relation(fields: [supplierOrderId], references: [id])
  quoteItem     QuoteItem     @relation(fields: [quoteItemId], references: [id])
}

model Invoice {
  id              String         @id @default(cuid())
  invoiceNumber   String
  quoteId         String         @unique
  status          InvoiceStatus  @default(NOT_CREATED)
  paymentRequired PaymentRequired @default(PREPAY_REQUIRED)
  markedPaidAt    DateTime?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  quote           Quote          @relation(fields: [quoteId], references: [id])
}

model GoodsReceipt {
  id              String   @id @default(cuid())
  grnNumber       String   @unique
  supplierOrderId String
  receivedByUserId String
  receivedAt      DateTime @default(now())
  documentRef     String
  attachmentUrl   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  supplierOrder SupplierOrder @relation(fields: [supplierOrderId], references: [id])
  receivedBy    User          @relation(fields: [receivedByUserId], references: [id])
  items         GoodsReceiptItem[]
}

model GoodsReceiptItem {
  id             String   @id @default(cuid())
  goodsReceiptId String
  quoteItemId    String
  qtyReceived    Int

  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id])
  quoteItem    QuoteItem    @relation(fields: [quoteItemId], references: [id])
}

model Dispatch {
  id               String              @id @default(cuid())
  dispatchNumber   String              @unique
  quoteId          String
  dispatchedByUserId String
  dispatchedAt     DateTime            @default(now())
  destination      DispatchDestination
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  quote         Quote        @relation(fields: [quoteId], references: [id])
  dispatchedBy  User         @relation(fields: [dispatchedByUserId], references: [id])
  items         DispatchItem[]
}

model DispatchItem {
  id          String   @id @default(cuid())
  dispatchId  String
  quoteItemId String
  qtyDispatched Int

  dispatch  Dispatch  @relation(fields: [dispatchId], references: [id])
  quoteItem QuoteItem @relation(fields: [quoteItemId], references: [id])
}

model QuoteAccessToken {
  id         String   @id @default(cuid())
  quoteId    String
  token      String   @unique
  expiresAt  DateTime?
  createdAt  DateTime @default(now())

  quote      Quote    @relation(fields: [quoteId], references: [id])
}

model Notification {
  id         String   @id @default(cuid())
  userId     String
  title      String
  body       String
  readAt     DateTime?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])
}

model Task {
  id          String     @id @default(cuid())
  userId      String
  quoteItemId String
  title       String
  status      TaskStatus @default(OPEN)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User       @relation(fields: [userId], references: [id])
  quoteItem   QuoteItem  @relation(fields: [quoteItemId], references: [id])
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Sequence {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
